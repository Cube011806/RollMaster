<div id="logDrawer" class="drawer drawer-left">
    <button type="button"
            class="drawer-tab"
            onclick="toggleDrawer('logDrawer')">
        Log
    </button>

    <div class="drawer-content">
        <h3>Log</h3>

        <div id="logMessages"></div>
    </div>
</div>

<div id="diceDrawer" class="drawer drawer-right">
    <button type="button"
            class="drawer-tab"
            onclick="toggleDrawer('diceDrawer')">
        Rzuty kostkami
    </button>

    <div class="drawer-content">
        <h3>Rzuty kostkami</h3>

        <button id="rollD12Button" class="btn btn-primary">
            Rzuć 1d12
        </button>
    </div>
</div>