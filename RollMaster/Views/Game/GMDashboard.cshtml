@model RollMaster.Models.Game

<h1>@Model.Name – Panel MG</h1>
<link rel="stylesheet" href="~/css/sidepanels.css" />

@if (Model.Characters != null && Model.Characters.Count > 0)
{
    @await Html.PartialAsync("_SidePanels", Model.Characters[0])
}
<div class="tabs">
    @for (int i = 0; i < Model.Characters.Count; i++)
    {
        <button class="tab-btn @(i == 0 ? "active" : "")" onclick="openTab(@i)">
            @Model.Characters[i].Imie
        </button>
    }
</div>

<div class="tab-content">
    @for (int i = 0; i < Model.Characters.Count; i++)
    {
        <div class="tab-pane @(i == 0 ? "active" : "")" id="tab-@i">
            @await Html.PartialAsync("_CharacterDashboard", Model.Characters[i])
        </div>
    }
</div>

<script src="~/js/signalr.min.js"></script>

<script>
    function openTab(index) {
        const tabs = document.querySelectorAll(".tab-pane");
        const buttons = document.querySelectorAll(".tab-btn");

        if (index < 0 || index >= tabs.length) {
            return;
        }

        tabs.forEach(tab => {
            tab.classList.remove("active");
        });

        buttons.forEach(button => {
            button.classList.remove("active");
        });

        const selectedTab = tabs[index];
        const selectedButton = buttons[index];

        selectedTab.classList.add("active");

        if (selectedButton) {
            selectedButton.classList.add("active");
        }

        if (typeof updateDicePanel === "function") {
            updateDicePanel(selectedTab);
        }

        localStorage.setItem("gmSelectedTab", index.toString());
    }

    function initForms() {
        const forms = document.querySelectorAll(".characterForm");

        forms.forEach(form => {
            if (form.dataset.initialized === "true") {
                return;
            }

            form.dataset.initialized = "true";

            let timeout = null;

            form.addEventListener("change", function () {
                clearTimeout(timeout);

                const tab = form.closest(".tab-pane");

                if (
                    tab &&
                    tab.classList.contains("active") &&
                    typeof updateDicePanel === "function"
                ) {
                    updateDicePanel(tab);
                }

                timeout = setTimeout(() => {
                    const formData = new FormData(form);

                    fetch("/Character/SaveCharacter", {
                        method: "POST",
                        body: formData
                    })
                    .then(response => {
                        if (!response.ok) {
                            console.error(
                                "Nie udało się zapisać postaci.",
                                response.status
                            );
                        }
                    })
                    .catch(error => {
                        console.error(
                            "Błąd podczas zapisywania postaci:",
                            error
                        );
                    });
                }, 500);
            });
        });
    }

    function initializeSelectedTab() {
        const tabs = document.querySelectorAll(".tab-pane");

        if (tabs.length === 0) {
            return;
        }

        const savedTab =
            localStorage.getItem("gmSelectedTab");

        let initialTabIndex = 0;

        if (savedTab !== null) {
            const savedIndex =
                Number.parseInt(savedTab, 10);

            if (
                !Number.isNaN(savedIndex) &&
                savedIndex >= 0 &&
                savedIndex < tabs.length
            ) {
                initialTabIndex = savedIndex;
            }
        }

        openTab(initialTabIndex);
    }

    initForms();
    initializeSelectedTab();

    const connection =
        new signalR.HubConnectionBuilder()
            .withUrl("/characterHub")
            .build();

    connection.start()
        .then(() => {
            console.log("SignalR connected");

            const activeTab =
                document.querySelector(".tab-pane.active");

            const gameIdInput =
                activeTab?.querySelector(
                    'input[name="GameId"]'
                ) ||
                document.querySelector(
                    'input[name="GameId"]'
                );

            if (!gameIdInput) {
                console.error(
                    "Nie znaleziono pola GameId."
                );

                return;
            }

            return connection.invoke(
                "JoinGame",
                gameIdInput.value
            );
        })
        .catch(error => {
            console.error(
                "Błąd połączenia SignalR:",
                error
            );
        });

    connection.on(
        "ReceiveCharacterUpdate",
        character => {
            const form = document.querySelector(
                `.characterForm[data-character-id="${character.id}"]`
            );

            if (!form) {
                return;
            }

            const container =
                form.closest(".tab-pane");

            if (!container) {
                return;
            }

            fetch(
                `/Character/CharacterPartial?id=${character.id}`
            )
            .then(response => {
                if (!response.ok) {
                    throw new Error(
                        `HTTP ${response.status}`
                    );
                }

                return response.text();
            })
            .then(html => {
                container.innerHTML = html;

                initForms();

                if (
                    container.classList.contains("active") &&
                    typeof updateDicePanel === "function"
                ) {
                    updateDicePanel(container);
                }
            })
            .catch(error => {
                console.error(
                    "Nie udało się odświeżyć postaci:",
                    error
                );
            });
        }
    );
</script>

<script src="~/js/sidepanels.js"></script>